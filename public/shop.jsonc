// お店ごとの設定（この1つだけ書きかえる）。// の行は注釈（読むときに外す）。2026/10/20
// 架空のお店 hiyori のデモ
{
  "shopName": "hiyori（架空のお店）",
  "color": { "main": "#e58ca0", "sub": "#a8834f" },
  "lineUrl": "",                       // 公式LINE の URL（空なら LINE のボタンを出さない）
  "tel": "",                           // 電話番号（空なら電話の案内を出さない）
  "menus": [                           // min＝施術の時間（分）
    { "name": "よもぎ蒸し", "min": 40, "price": "5,500円" },
    { "name": "フェイシャル", "min": 60, "price": "5,500円" },
    { "name": "ボディケア 60分", "min": 60, "price": "6,600円" },
    { "name": "ボディケア 90分", "min": 90, "price": "9,900円" },
    { "name": "脱毛（部位はご相談）", "min": 60, "price": "部位による" }
  ],
  "bufferMin": 20,                     // 片づけ・準備の時間（予約のあとに自動で空ける）
  "stepMin": 30,                       // お客さんが選べる開始時間のきざみ
  "patterns": [                        // 営業日の型の初期値（お店の画面で変えられる）
    { "name": "1日", "s": "10:00", "e": "18:00" },
    { "name": "午前", "s": "10:00", "e": "13:00" },
    { "name": "午後", "s": "13:00", "e": "18:00" },
    { "name": "夕方から", "s": "17:00", "e": "21:00" }
  ],
  "bookPatterns": [                    // 予約の型の初期値（お店が手で入れるときの長さ。お店の画面で変えられる）
    { "name": "よもぎ蒸し", "min": 40 },
    { "name": "フェイシャル", "min": 60 },
    { "name": "ボディケア60", "min": 60 },
    { "name": "ボディケア90", "min": 90 },
    { "name": "脱毛", "min": 60 }
  ],
  "cancelPolicy": "前日のキャンセルは料金の50%、当日は100%をいただきます。",
  "askEmail": true,
  "formspree": "https://formspree.io/f/xrpeekdb",   // 予約の知らせの送り先（空なら予約を受け付けない）
  "daysAhead": 60,                     // 何日先まで予約を受けるか
  "sameDayCutoffMin": 120              // 当日は何分前まで受けるか
}
