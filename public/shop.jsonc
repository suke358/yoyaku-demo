// お店ごとの設定（この1つだけ書きかえる）。// の行は注釈（読むときに外す。注釈に引用符は書けない）。2026/10/20（10/21 項目を増やした）
// 架空のお店 hiyori のデモ。新しいお店では、このファイルをそのお店の値に書きかえる（worker.js・画面・gas/Code.gs にお店の値は書かない）
{
  "shopName": "hiyori（架空のお店）",   // 画面の見出し・確認メールの差出人の名前・ホーム画面の名前
  "shortName": "hiyori",               // メールの件名の【〇〇】に使う短い名前（空なら shopName）
  "color": { "main": "#e58ca0", "sub": "#a8834f" },
  "lineUrl": "",                       // 公式LINE の URL（空なら LINE のボタンを出さない）
  "tel": "",                           // 電話番号（空なら電話の案内を出さない）
  "mail": "",                          // お店のメール（確認メールの返信先・お店への知らせの宛先。GAS を入れた Google のメール。デモでは使わない）
  "address": "",                       // 確認メールに書く住所（空なら書かない）
  "parking": "",                       // 確認メールに書く駐車場の案内（空なら書かない）
  "menus": [                           // min＝施術の時間（分）。price は税込の金額か「お問い合わせください」
    { "name": "よもぎ蒸し", "min": 40, "price": "5,500円" },
    { "name": "フェイシャル", "min": 60, "price": "5,500円" },
    { "name": "ボディケア 60分", "min": 60, "price": "6,600円" },
    { "name": "ボディケア 90分", "min": 90, "price": "9,900円" },
    { "name": "脱毛", "min": 60, "price": "お問い合わせください" }
  ],
  "otherMenusNote": "そのほかのメニューは、公式LINEでご相談ください。",   // ネット予約に出さないメニューの案内（空なら出さない。LINE のボタン付き）
  "bufferMin": 20,                     // 片づけ・準備の時間（全メニュー共通。施術のあとに足して枠をふさぐ）
  "stepMin": 30,                       // お客さんが選べる開始時間のきざみ
  "patterns": [                        // 営業日の型の初期値（お店の画面で変えられる）
    { "name": "1日", "s": "10:00", "e": "18:00" },
    { "name": "午前", "s": "10:00", "e": "13:00" },
    { "name": "午後", "s": "13:00", "e": "18:00" },
    { "name": "夕方から", "s": "17:00", "e": "21:00" }
  ],
  "bookPatterns": [                    // 予約の型の初期値（お店が手で入れるときの長さ。お店の画面で変えられる）
    { "name": "よもぎ蒸し", "min": 40 },
    { "name": "フェイシャル", "min": 60 },
    { "name": "ボディケア60", "min": 60 },
    { "name": "ボディケア90", "min": 90 },
    { "name": "脱毛", "min": 60 }
  ],
  "cancelPolicy": "前日のキャンセルは料金の50%、当日は100%をいただきます。",
  "notice": "",                        // キャンセルの箱に太字で出す一言（例：妊娠中の方・持病のある方は、事前にご相談ください。空なら出さない）
  "daysAhead": 0,                      // 何日先まで受けるか。0 ＝ 上限なし（お店の画面で営業日を入れた日はすべて受ける）
  "sameDayCutoffMin": 120,             // 当日は何分前まで受けるか
  // デモ用（本番のお店では demo を false にし、demoPassword は消す）
  "demo": true,                        // true：メールを送らず、予約のあとに確認メールの見本を出す。秘密の変数がなくても予約を受け付ける
  "demoPassword": "hiyori2026"         // お店の画面のログインに表示する（Cloudflare の ADMIN_PASSWORD も同じ値を担当者が入れる）
}
